#!/bin/sh
set -eu
BRIDGE_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BRIDGE_CLIENT="${BRIDGE_TUNNEL_CLIENT:-$HOME/.local/share/chatgpt-codex-bridge/runtime/bin/tunnel-client}"
if [ ! -x "$BRIDGE_CLIENT" ]; then
  BRIDGE_CLIENT="$(command -v tunnel-client || true)"
fi
if [ -z "$BRIDGE_CLIENT" ] || [ ! -x "$BRIDGE_CLIENT" ]; then
  echo 'tunnel-client 未安装。使用官方 Platform Tunnels 页面下载：https://platform.openai.com/settings/organization/tunnels' >&2
  exit 2
fi
BRIDGE_MODE="${1:-foreground}"
if [ "$BRIDGE_MODE" = status ]; then
  exec "$BRIDGE_CLIENT" runtimes status chatgpt-code-analysis --json
fi
BRIDGE_RUNTIME="$HOME/.local/share/chatgpt-codex-bridge/runtime"
if [ -z "${CONTROL_PLANE_TUNNEL_ID:-}" ] && [ -f "$BRIDGE_RUNTIME/tunnel-id" ]; then
  CONTROL_PLANE_TUNNEL_ID="$(cat "$BRIDGE_RUNTIME/tunnel-id")"
  export CONTROL_PLANE_TUNNEL_ID
fi
: "${CONTROL_PLANE_TUNNEL_ID:?请设置 Tunnel ID}"
if [ -n "${CONTROL_PLANE_API_KEY:-}" ]; then
  BRIDGE_KEY_REF='env:CONTROL_PLANE_API_KEY'
elif [ -s "$BRIDGE_RUNTIME/runtime-key" ]; then
  if ! "$BRIDGE_ROOT/.venv/bin/python" -c 'import os,stat,sys; p=sys.argv[1]; s=os.lstat(p); sys.exit(0 if stat.S_ISREG(s.st_mode) and s.st_uid == os.getuid() and not s.st_mode & 0o077 else 2)' "$BRIDGE_RUNTIME/runtime-key"; then
    echo 'runtime-key 必须是当前用户所有、权限 0600 的普通文件' >&2; exit 2
  fi
  BRIDGE_KEY_REF="file:$BRIDGE_RUNTIME/runtime-key"
else
  echo '缺少 Tunnel runtime key：在本机设置 CONTROL_PLANE_API_KEY，或写入权限 0600 的 runtime/runtime-key；不要粘贴进聊天' >&2
  exit 2
fi
if ! "$BRIDGE_ROOT/.venv/bin/python" -c 'import os,re,sys; sys.exit(0 if re.fullmatch(r"tunnel_[0-9a-f]{32}", os.environ["CONTROL_PLANE_TUNNEL_ID"]) else 2)'; then
  echo 'Tunnel ID 格式错误，需要 tunnel_ 加 32 位小写十六进制' >&2; exit 2
fi
if [ "$BRIDGE_MODE" = connect ]; then
  exec "$BRIDGE_CLIENT" runtimes connect --alias chatgpt-code-analysis \
    --tunnel-id "$CONTROL_PLANE_TUNNEL_ID" --profile chatgpt-code-analysis \
    --profile-dir "$HOME/.local/share/chatgpt-codex-bridge/runtime/profiles" \
    --runtime-api-key "$BRIDGE_KEY_REF" \
    --mcp-command "\"$BRIDGE_ROOT/.venv/bin/python\" \"$BRIDGE_ROOT/server.py\"" --json
fi
if [ "$BRIDGE_MODE" != foreground ]; then
  echo '用法：scripts/tunnel [foreground|connect|status]' >&2; exit 2
fi
# Official client supervises its stdio MCP child; no public unauthenticated HTTP.
exec "$BRIDGE_CLIENT" run --control-plane.tunnel-id "$CONTROL_PLANE_TUNNEL_ID" \
  --control-plane.api-key "$BRIDGE_KEY_REF" \
  --mcp.command "command=\"$BRIDGE_ROOT/.venv/bin/python\" \"$BRIDGE_ROOT/server.py\",channel=main" \
  --mcp.stdio-send-initialized-notification \
  --health.listen-addr 127.0.0.1:18766
